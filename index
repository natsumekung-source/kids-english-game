<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>English & Thai Classroom Learning</title>
    <style>
        /* Modern, clean, minimalist child-friendly palette */
        :root {
            --bg-color: #f7f9fc;
            --card-bg: #ffffff;
            --text-main: #2d3748;
            --primary-blue: #4a90e2;
            --accent-green: #2ecc71;
            --accent-orange: #f39c12;
            --accent-pink: #ef5777;
            --accent-purple: #8854d0;
            --border-radius: 20px;
            --shadow: 0 8px 16px rgba(0,0,0,0.06);
        }

        body {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        header {
            text-align: center;
            margin-bottom: 30px;
            max-width: 600px;
        }

        h1 {
            color: var(--primary-blue);
            font-size: 2.2rem;
            margin-bottom: 5px;
        }

        p.subtitle {
            font-size: 1.1rem;
            color: #718096;
            margin-top: 0;
        }

        /* Mode Selector */
        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .tab-btn {
            background-color: var(--card-bg);
            border: 2px solid #e2e8f0;
            padding: 12px 24px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: var(--shadow);
        }

        .tab-btn.active {
            background-color: var(--primary-blue);
            color: white;
            border-color: var(--primary-blue);
        }

        /* Game & Card Layout */
        .container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            width: 100%;
            max-width: 1000px;
        }

        /* Sub-headings for Spelling Groups */
        .spelling-section-title {
            grid-column: 1 / -1;
            font-size: 1.6rem;
            color: var(--text-main);
            margin: 20px 0 5px 0;
            padding-bottom: 10px;
            border-bottom: 3px dashed #e2e8f0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card {
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            padding: 25px;
            text-align: center;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            cursor: pointer;
            border: 3px solid transparent;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            min-height: 280px;
        }

        .card-image-box {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100px;
            height: 100px;
            margin-bottom: 15px;
        }

        .card-image-box svg {
            width: 100%;
            height: 100%;
        }

        /* Styling for Phonics Equation Blocks */
        .phonics-equation {
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Courier New', Courier, monospace;
            font-size: 1.4rem;
            font-weight: bold;
            background: #f1f2f6;
            padding: 10px 15px;
            border-radius: 15px;
            border: 2px dashed #cbd5e0;
            color: #4a5568;
            width: 90%;
            box-sizing: border-box;
        }
        .phonics-root { color: var(--accent-pink); font-size: 1.6rem; }
        .phonics-family { color: var(--primary-blue); font-size: 1.6rem; }
        .phonics-result { color: var(--accent-green); font-size: 1.7rem; }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(74, 144, 226, 0.15);
            border-color: #ebf4ff;
        }

        .card:active {
            transform: scale(0.98);
        }

        .word-eng {
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--primary-blue);
            margin-bottom: 5px;
        }

        .word-thai {
            font-size: 1.4rem;
            color: var(--accent-green);
            margin-bottom: 5px;
            font-weight: 500;
        }

        .word-ipa {
            font-size: 1.0rem;
            color: #a0aec0;
            font-style: italic;
        }

        /* Sound Buttons */
        .sound-controls {
            display: flex;
            gap: 10px;
            margin-top: 15px;
            width: 100%;
        }

        .sound-btn {
            flex: 1;
            border: none;
            padding: 10px;
            border-radius: 12px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.2s;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

        .btn-en {
            background-color: #ebf8ff;
            color: #2b6cb0;
        }

        .btn-en:hover {
            background-color: #bee3f8;
        }

        .btn-th {
            background-color: #f0fff4;
            color: #2f855a;
        }

        .btn-th:hover {
            background-color: #c6f6d5;
        }

        /* Opposites Styling */
        .opposite-frame {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            margin-bottom: 15px;
            width: 100%;
        }

        .opposite-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 1;
        }

        .opposite-item .card-image-box {
            width: 80px;
            height: 80px;
        }

        .opposite-separator {
            font-size: 1.5rem;
            color: #e2e8f0;
            font-weight: bold;
        }

        /* Number Visual Layout */
        .number-badge {
            background-color: var(--accent-pink);
            color: white;
            font-size: 2.2rem;
            font-weight: 900;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 10px;
            box-shadow: 0 4px 10px rgba(239, 87, 119, 0.3);
        }

        .grid-count {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 4px;
            max-width: 110px;
            justify-content: center;
            margin-top: 10px;
        }

        .dot {
            width: 14px;
            height: 14px;
            background-color: var(--accent-pink);
            border-radius: 50%;
            display: inline-block;
        }

        /* Game Section Styling */
        .game-area {
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            padding: 30px;
            width: 100%;
            max-width: 600px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            box-sizing: border-box;
        }

        .game-word-display {
            font-size: 3rem;
            font-weight: bold;
            letter-spacing: 12px;
            color: var(--primary-blue);
            margin: 20px 0;
            text-transform: uppercase;
        }

        .game-instruction {
            font-size: 1.2rem;
            color: #718096;
            margin-bottom: 15px;
        }

        .choices-grid {
            display: flex;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 20px;
            width: 100%;
        }

        .choice-btn {
            background-color: #f1f2f6;
            border: 3px solid #dfe4ea;
            color: var(--text-main);
            font-size: 1.8rem;
            font-weight: bold;
            border-radius: 15px;
            width: 60px;
            height: 60px;
            cursor: pointer;
            transition: all 0.15s ease;
            text-transform: uppercase;
        }

        .choice-btn:hover {
            transform: translateY(-2px);
            background-color: var(--primary-blue);
            color: white;
            border-color: var(--primary-blue);
        }

        .choice-btn:active {
            transform: scale(0.95);
        }

        /* Picture Selection Grid for the new game */
        .pic-choices-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin: 25px 0;
            width: 100%;
        }

        .pic-choice-card {
            background-color: #f8f9fa;
            border: 3px solid #e2e8f0;
            border-radius: 15px;
            padding: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .pic-choice-card:hover {
            border-color: var(--primary-blue);
            background-color: #ebf4ff;
            transform: translateY(-3px);
        }

        .audio-trigger-btn {
            background-color: var(--primary-blue);
            color: white;
            border: none;
            padding: 15px 35px;
            font-size: 1.3rem;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(74, 144, 226, 0.3);
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.2s;
        }

        .audio-trigger-btn:hover {
            transform: scale(1.05);
            background-color: #357abd;
        }

        /* Result Splash Box */
        .result-splash {
            margin-top: 25px;
            padding: 15px 30px;
            font-size: 1.6rem;
            font-weight: bold;
            border-radius: 30px;
            transition: all 0.3s ease;
            min-height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 80%;
        }

        .result-correct {
            background-color: #d4edda;
            color: #155724;
            border: 3px solid #c3e6cb;
            animation: bounce 0.5s ease;
        }

        .result-incorrect {
            background-color: #f8d7da;
            color: #721c24;
            border: 3px solid #f5c6cb;
            animation: shake 0.4s ease;
        }

        @keyframes bounce {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }

        .next-btn {
            margin-top: 20px;
            background-color: var(--accent-green);
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(46, 204, 113, 0.3);
            transition: transform 0.2s;
        }

        .next-btn:hover {
            transform: scale(1.05);
        }

        .hidden {
            display: none !important;
        }

        footer {
            margin-top: 50px;
            font-size: 0.85rem;
            color: #a0aec0;
            text-align: center;
        }
    </style>
</head>
<body>

    <header>
        <h1>🎒 Fun English & Thai Sandbox</h1>
        <p class="subtitle">Perfect for 6-year-olds! Tap any voice button to hear how the words are spoken.</p>
    </header>

    <div class="tabs">
        <button class="tab-btn active" onclick="switchTab('vocab')">🏫 Classroom Words</button>
        <button class="tab-btn" onclick="switchTab('family')">👨‍👩‍👧‍👦 Family Words</button>
        <button class="tab-btn" onclick="switchTab('inenun')">🔤 in en un</button>
        <button class="tab-btn" onclick="switchTab('spelling')">✏️ Spelling Families</button>
        <button class="tab-btn" onclick="switchTab('opposites')">⚖️ Opposites</button>
        <button class="tab-btn" onclick="switchTab('numbers')">🔢 Numbers 1-10</button>
        <button class="tab-btn" onclick="switchTab('game')">🎮 AEIOU Game</button>
        <button class="tab-btn" onclick="switchTab('picgame')">🔊 Picture Game</button>
    </div>

    <!-- Classroom Vocabulary Cards -->
    <div id="vocab-container" class="container"></div>

    <!-- Family Vocabulary Cards -->
    <div id="family-container" class="container hidden"></div>

    <!-- in en un Vocabulary Cards -->
    <div id="inenun-container" class="container hidden"></div>

    <!-- UPDATED Spelling Vocabulary Cards (Divided into 3 Phonics Groups) -->
    <div id="spelling-container" class="container hidden">
        <!-- Will be dynamically populated into subgroups -->
    </div>

    <!-- Opposites Cards -->
    <div id="opposites-container" class="container hidden"></div>

    <!-- Numbers Cards -->
    <div id="numbers-container" class="container hidden"></div>

    <!-- Game Session (AEIOU Game) -->
    <div id="game-container" class="container hidden" style="justify-content: center; display: flex;">
        <div class="game-area">
            <h2 style="color: var(--accent-purple); margin-top: 0;">🎯 Vowel Missing Game!</h2>
            <div class="game-instruction">Look at the picture and find the missing vowel (A, E, I, O, U)!</div>
            
            <div id="game-image-container" class="card-image-box" style="width: 120px; height: 120px;"></div>

            <div id="game-word" class="game-word-display">_ _ _ _ _</div>
            <div id="game-thai" class="word-thai" style="font-size: 1.5rem; margin-bottom: 20px;"></div>

            <div class="choices-grid">
                <button class="choice-btn" onclick="submitAnswer('a')">A</button>
                <button class="choice-btn" onclick="submitAnswer('e')">E</button>
                <button class="choice-btn" onclick="submitAnswer('i')">I</button>
                <button class="choice-btn" onclick="submitAnswer('o')">O</button>
                <button class="choice-btn" onclick="submitAnswer('u')">U</button>
            </div>

            <div id="game-feedback" class="result-splash hidden"></div>
            <button id="next-question-btn" class="next-btn hidden" onclick="generateNewQuestion()">Next Word ➡️</button>
        </div>
    </div>

    <!-- Game Session (Picture Matching Game) -->
    <div id="picgame-container" class="container hidden" style="justify-content: center; display: flex;">
        <div class="game-area">
            <h2 style="color: var(--accent-pink); margin-top: 0;">🔊 Picture Matching Game!</h2>
            <div class="game-instruction">Click the button to listen, then choose the correct picture!</div>
            
            <button class="audio-trigger-btn" onclick="playPicGameAudio()">🔊 Listen to the Word</button>

            <div class="pic-choices-grid">
                <div id="pic-choice-0" class="pic-choice-card" onclick="submitPicAnswer(0)"></div>
                <div id="pic-choice-1" class="pic-choice-card" onclick="submitPicAnswer(1)"></div>
                <div id="pic-choice-2" class="pic-choice-card" onclick="submitPicAnswer(2)"></div>
            </div>

            <div id="pic-game-feedback" class="result-splash hidden"></div>
            <button id="next-pic-question-btn" class="next-btn hidden" onclick="generateNewPicQuestion()">Next Level ➡️</button>
        </div>
    </div>

    <footer>
        Uses the native Web Speech API built into your browser. Recommended on Safari/Chrome.
    </footer>


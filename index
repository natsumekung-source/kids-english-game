        // Core Voice Function
        function speakWord(text, lang) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = lang;
                if (lang === 'en-US') {
                    utterance.rate = 0.80;
                    utterance.pitch = 1.15;
                } else if (lang === 'th-TH') {
                    utterance.rate = 1.0;
                    utterance.pitch = 1.4;
                }
                window.speechSynthesis.speak(utterance);
            }
        }

        // SPELLING SPECIAL: Speaks letters one-by-one, then says the whole word!
        function speakSpellingPhonics(word, root, family) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                
                // 1. Spell the letters individually
                const letters = word.toUpperCase().split('').join(' . '); 
                const spellUtterance = new SpeechSynthesisUtterance(letters);
                spellUtterance.lang = 'en-US';
                spellUtterance.rate = 0.75;
                spellUtterance.pitch = 1.2;

                // 2. Pronounce the complete combined word after spelling
                spellUtterance.onend = () => {
                    setTimeout(() => {
                        const wordUtterance = new SpeechSynthesisUtterance(word);
                        wordUtterance.lang = 'en-US';
                        wordUtterance.rate = 0.80;
                        wordUtterance.pitch = 1.15;
                        window.speechSynthesis.speak(wordUtterance);
                    }, 400);
                };

                window.speechSynthesis.speak(spellUtterance);
            }
        }


                    </div>
                    <div class="sound-controls">
                        <button class="sound-btn btn-en" onclick="event.stopPropagation(); speakWord('${item.eng}', 'en-US')">📣 ENG</button>
                    </div>
                `;
                card.addEventListener('click', () => speakWord(item.eng, 'en-US'));
                container.appendChild(card);
            });
        }

        // ================= GAME ENGINE 1 (AEIOU) =================
        let currentQuestion = {}; let missingLetter = ''; let displayWord = ''; let isAnswered = false;
        function generateNewQuestion() {
            isAnswered = false;
            document.getElementById('game-feedback').classList.add('hidden');
            document.getElementById('next-question-btn').classList.add('hidden');
            const randomIndex = Math.floor(Math.random() * totalGamePool.length);
            currentQuestion = totalGamePool[randomIndex];
            const vowels = ['a', 'e', 'i', 'o', 'u'];
            let wordStr = currentQuestion.eng.toLowerCase();
            let vowelPositions = [];
            for (let i = 0; i < wordStr.length; i++) { if (vowels.includes(wordStr[i])) vowelPositions.push(i); }
            if (vowelPositions.length > 0) {
                const targetPosition = vowelPositions[Math.floor(Math.random() * vowelPositions.length)];
                missingLetter = wordStr[targetPosition];
                let displayArr = wordStr.split(''); displayArr[targetPosition] = '_'; displayWord = displayArr.join('');
            } else { missingLetter = 'e'; displayWord = 'p_n'; }
            document.getElementById('game-image-container').innerHTML = currentQuestion.svg;
            document.getElementById('game-word').textContent = displayWord;
            document.getElementById('game-thai').textContent = currentQuestion.thai;
        }
        function submitAnswer(chosenLetter) {
            if (isAnswered) return;
            const feedbackEl = document.getElementById('game-feedback'); feedbackEl.classList.remove('hidden');
            if (chosenLetter.toLowerCase() === missingLetter.toLowerCase()) {
                isAnswered = true; feedbackEl.className = 'result-splash result-correct';
                feedbackEl.textContent = '🎉 Correct! It is: ' + currentQuestion.eng.toUpperCase();
                document.getElementById('game-word').textContent = currentQuestion.eng;
                speakWord('ถูกต้องจ้า', 'th-TH'); setTimeout(() => { speakWord(currentQuestion.eng, 'en-US'); }, 1100);
                document.getElementById('next-question-btn').classList.remove('hidden');
            } else { feedbackEl.className = 'result-splash result-incorrect'; feedbackEl.textContent = '😢 Incorrect! Try again!'; speakWord('ลองใหม่น้า', 'th-TH'); }
        }

        // ================= GAME ENGINE 2 (PICTURE MATCHING) =================
        let picGameCorrectItem = {}; let picGameOptions = []; let isPicAnswered = false;
        function generateNewPicQuestion() {
            isPicAnswered = false; document.getElementById('pic-game-feedback').classList.add('hidden'); document.getElementById('next-pic-question-btn').classList.add('hidden');
            picGameCorrectItem = totalGamePool[Math.floor(Math.random() * totalGamePool.length)];
            let pool = totalGamePool.filter(item => item.eng !== picGameCorrectItem.eng).sort(() => 0.5 - Math.random());
            picGameOptions = [picGameCorrectItem, pool[0], pool[1]].sort(() => 0.5 - Math.random());
            for (let i = 0; i < 3; i++) {
                const choiceCard = document.getElementById(`pic-choice-${i}`);
                if(picGameOptions[i].num) {
                    choiceCard.innerHTML = `<div class="number-badge" style="width:45px; height:45px; font-size:1.5rem; margin:0;">${picGameOptions[i].num}</div>`;
                } else { choiceCard.innerHTML = `<div class="card-image-box" style="margin:0; width:85px; height:85px;">${picGameOptions[i].svg}</div>`; }
                choiceCard.style.borderColor = "#e2e8f0"; choiceCard.style.backgroundColor = "#f8f9fa";
            }
            setTimeout(() => { playPicGameAudio(); }, 300);
        }
        function playPicGameAudio() { if (picGameCorrectItem) speakWord(picGameCorrectItem.eng, 'en-US'); }
        function submitPicAnswer(selectedIndex) {
            if (isPicAnswered) return;
            const feedbackEl = document.getElementById('pic-game-feedback'); feedbackEl.classList.remove('hidden');
            if (picGameOptions[selectedIndex].eng === picGameCorrectItem.eng) {
                isPicAnswered = true; feedbackEl.className = 'result-splash result-correct';
                feedbackEl.textContent = `🎉 Correct! This is "${picGameCorrectItem.eng.toUpperCase()}"`;
                document.getElementById(`pic-choice-${selectedIndex}`).style.borderColor = "var(--accent-green)";
                speakWord('ถูกต้องจ้า', 'th-TH'); document.getElementById('next-pic-question-btn').classList.remove('hidden');
            } else { feedbackEl.className = 'result-splash result-incorrect'; speakWord('ลองใหม่น้า', 'th-TH'); }
        }

        // Tab Switcher
        function switchTab(tabName) {
            const containers = {
                vocab: document.getElementById('vocab-container'), family: document.getElementById('family-container'),
                inenun: document.getElementById('inenun-container'), spelling: document.getElementById('spelling-container'),
                opposites: document.getElementById('opposites-container'), numbers: document.getElementById('numbers-container'),
                game: document.getElementById('game-container'), picgame: document.getElementById('picgame-container')
            };
            const tabs = document.querySelectorAll('.tab-btn');
            tabs.forEach(btn => btn.classList.remove('active'));
            Object.values(containers).forEach(c => c.classList.add('hidden'));

            const activeIndex = { vocab:0, family:1, inenun:2, spelling:3, opposites:4, numbers:5, game:6, picgame:7 }[tabName];
            tabs[activeIndex].classList.add('active');
            containers[tabName].classList.remove('hidden');

            if (tabName === 'game') generateNewQuestion();
            if (tabName === 'picgame') generateNewPicQuestion();
        }

        window.addEventListener('DOMContentLoaded', () => {
            renderStandardCards(classroomVocabulary, 'vocab-container');
            renderStandardCards(familyVocabulary, 'family-container');
            renderStandardCards(inEnUnVocabulary, 'inenun-container');
            renderSpellingSections(); // Build custom multi-group layout
            renderOppositeCards();
            renderNumbersCards();
        });
    </script>
</body>
